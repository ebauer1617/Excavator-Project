{
  "name": "excavator-telemetry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=18.17" },
  "scripts": {
    "build:client": "tsc -p tsconfig.client.json",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:client && npm run build:server",
    "dev": "npm run build:client && tsx src/server.ts",
    "dev:sim": "npm run build:client && tsx src/server.ts --sim",
    "start": "npm run build && node dist/server.js",
    "stop": "node scripts/kill-port.mjs",
    "ports": "tsx src/server.ts --list"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
